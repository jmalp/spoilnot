<?xml version="1.0" encoding="utf-8"?>
<!-- Dev debug and dev benchmark only. Android 17 blocks apps targeting API 37 from private-network addresses such
     as the emulator host 10.0.2.2 unless this permission is granted. Release and prod builds never declare it.
     profileable lets the macrobenchmarks (benchmark module) trace the non-debuggable benchmark build. Firebase
     Sessions stays off: against the emulators' demo project its uploads fail and their retries restart the app. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />

    <application>
        <profileable android:shell="true" />
        <meta-data
            android:name="firebase_sessions_enabled"
            android:value="false" />
    </application>
</manifest>
