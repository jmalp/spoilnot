{
  "name": "spoilnot-firebase",
  "private": true,
  "type": "module",
  "description": "Firestore rules, emulator config and rules tests for Spoil Not",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "emulators": "firebase emulators:start --project demo-spoilnot --import .emulator-data --export-on-exit .emulator-data",
    "test": "firebase emulators:exec --project demo-spoilnot --only firestore \"node --test --test-concurrency=1 'test/**/*.test.js'\"",
    "test:watch": "node --test --watch 'test/**/*.test.js'"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "firebase": "13.0.0",
    "firebase-tools": "15.34.0"
  }
}
